# =============================================================================
# Copy to .env.local (local) or paste into Vercel env settings.
# Marked [REQ] are required to boot. [OPT] degrade gracefully when absent.
# =============================================================================

# === Admin auth (Basic) [REQ] ===
# Without these, every /admin/* route 401s by design (fail-closed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# === Postgres (Railway) [REQ] ===
# 23 migrations live in infra/postgres/. Apply once via `psql "$DATABASE_URL" -f infra/postgres/<NNN>_*.sql`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional read-replica routed for admin dashboards and storefront reads.
DATABASE_URL_REPLICA=

# === Medusa v2 backend [REQ] ===
MEDUSA_URL=https://your-medusa-backend.example.com
NEXT_PUBLIC_MEDUSA_URL=https://your-medusa-backend.example.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# === OpenAI [REQ] — sole LLM provider (June 2026 migration off Kimi/Anthropic) ===
# Every agent + chat call goes through the official OpenAI API.
#   OPENAI_API_KEY     — official OpenAI key (format: sk-...)
#   OPENAI_CHAT_MODEL  — chat / light calls (default: gpt-4o)
#   OPENAI_AGENT_MODEL — agent / store-creator / super-agent (default: gpt-4.1)
#   OPENAI_BASE_URL    — override API base (default: https://api.openai.com/v1)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_AGENT_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Suppliers — socle dropshipping (V1 + V2)
# Les tokens OAuth (Zendrop, AutoDS) ne sont PAS des vars d'env : ils sont
# stockes AES-256-GCM dans platform_settings (cles zendrop_access_token,
# zendrop_refresh_token, autods_api_token) via STORE_SECRETS_KEY (ci-dessous).
# =============================================================================

# --- AliExpress DS API (V1 — active) [REQ pour creation de store] ---
# OAuth token stocke en DB apres /api/aliexpress/oauth/start.
# Rafraichi automatiquement par GitHub Actions (ae-token-refresh.yml).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- CJ Dropshipping (V1 — active) [REQ pour creation de store] ---
# CJ_DROPSHIPPING_API_KEY = cle generee dans Account Settings -> Developer,
# PAS le mot de passe du compte (sinon erreur 1600005 APIkey is wrong).
CJ_DROPSHIPPING_EMAIL=
CJ_DROPSHIPPING_API_KEY=

# --- Zendrop (V1 — active, transport MCP JSON-RPC) [OPT] ---
# Recommande: token API statique (ZendropConnector). Cree un token dans
# app.zendrop.com (scopes catalog:read, stores:read, orders:write...) et colle-le
# ci-dessous. Backend-only, ne jamais committer la vraie valeur.
# Verifier avec: node scripts/check-zendrop.mjs
ZENDROP_API_TOKEN=
# Optionnel: override du endpoint MCP (defaut https://app.zendrop.com/mcp/v1)
SUPPLIER_ZENDROP_MCP_URL=
# Legacy OAuth PKCE (flow /api/zendrop/oauth/start -> tokens en platform_settings).
# Superflu si ZENDROP_API_TOKEN est defini.
SUPPLIER_ZENDROP_CLIENT_ID=
SUPPLIER_ZENDROP_CLIENT_SECRET=

# --- Spocket (V1 — search_only, pas d API commande headless) [OPT] ---
# Recherche produits uniquement ; fulfillment manuel via dashboard Spocket.
SUPPLIER_SPOCKET_API_KEY=

# --- Syncee (V1 — feed-only, filtre isDropshipDirect obligatoire) [OPT] ---
# Importation de feed uniquement ; passer isDropshipDirect=true dans les
# requetes pour exclure les lots grossistes. Commandes manuelles.
SUPPLIER_SYNCEE_API_KEY=
SUPPLIER_SYNCEE_FEED_URL=

# --- BigBuy (V2 — active, flow check->create) [OPT] ---
# Verifier la disponibilite (check) avant de creer la commande (create).
# Pas de mode sandbox detecte dans la lib actuelle.
BIGBUY_API_KEY=

# --- Wholesale2B (V2 — feed-only) [OPT] ---
W2B_API_KEY=

# --- Doba (V2 — feed-only, signature + prepay a CONFIRMER) [OPT] ---
# Le mecanisme de signature de requete et le prepay sont a valider
# avec la doc API Doba avant toute commande live.
DOBA_ACCESS_KEY=
DOBA_SECRET=

# --- Inventory Source (V2 — feed-only) [OPT] ---
INVENTORY_SOURCE_API_KEY=

# --- AutoDS (couche d automatisation, PAS un fournisseur) [OPT] ---
# AUTODS_ROUTING_ENABLED='1' active le forwarding via AutoDS.
# OFF par defaut. Token OAuth stocke dans platform_settings (autods_api_token).
AUTODS_API_URL=
AUTODS_BUYER_ACCOUNT_ID=
AUTODS_ROUTING_ENABLED=     # mettre '1' pour activer le routing AutoDS

# --- Taux de change FX [OPT] ---
# Override du taux USD->EUR en attendant une source FX live.
# Defaut applique par lib/suppliers/fx.ts : 0.92.
SUPPLIER_USD_EUR_RATE=

# === Stripe (storefront checkout) [REQ] ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === Object storage — Cloudflare R2 [REQ for asset generation] ===
# Without R2 the asset generator falls back to writing under public/generated/
# (dev only; Vercel filesystem is read-only).
R2_ACCOUNT_ID=
R2_BUCKET=dropship-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-XXXX.r2.dev

# === Image / video generation [OPT but required for the medias copilote] ===
# fal.ai is the default backend (flux-pro/kontext for images, kling-video for promos).
FAL_KEY=
# ComfyUI Deploy override (replaces fal.ai when set). Multiple deployment IDs
# enable round-robin across GPUs.
COMFY_DEPLOY_API_KEY=
COMFYUI_URL=
COMFY_DEPLOYMENT_HERO=
COMFY_DEPLOYMENT_CUTOUT=
COMFY_DEPLOYMENT_LIFESTYLE=
COMFY_DEPLOYMENT_VIDEO=
COMFY_DEPLOYMENT_IDS=          # comma-separated, enables round-robin

# === Secrets encryption [REQ for analytics tokens] ===
# AES-256-GCM key (32 bytes base64). Encrypts Meta CAPI / TikTok Events / GA4
# secret tokens at rest in dropship_stores.
STORE_SECRETS_KEY=

# === Sentry [OPT] ===
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# === Meta Marketing API [OPT — required to push ads to Meta] ===
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXX

# === TikTok Marketing API [OPT — required once TikTok approves the app] ===
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# === Google Ads API [OPT — required to push ads + Enhanced Conversions] ===
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # 10-digit, no dashes (the operating account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # MCC parent; leave blank if OAuth has direct access
GOOGLE_ADS_CONVERSION_ACTION=    # e.g. customers/2877134493/conversionActions/7607691528
GOOGLE_MERCHANT_CENTER_ID=

# === Research providers (niche copilote) [OPT] ===
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# === SEO verification [OPT] ===
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Cross-platform helpers (configured but not yet wired in this app) [OPT] ===
OPENAI_API_KEY=                  # embeddings (future product similarity)
RESEND_API_KEY=                  # transactional email (anomaly alerts)
RESEND_FROM_EMAIL="Hearst Dropship <noreply@hearst.app>"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AXIOM_TOKEN=
AXIOM_DATASET=
ARCJET_KEY=
